register functions/sample
[[0,0.0,0.0],true]
table_create Values TABLE_NO_KEY
[[0,0.0,0.0],true]
column_create Values value COLUMN_SCALAR ShortText
[[0,0.0,0.0],true]
load --table Values
[
{"value": "a"},
{"value": "b"},
{"value": "c"},
{"value": "ab"},
{"value": "bc"},
{"value": "ca"},
{"value": "abc"}
]
[[0,0.0,0.0],7]
select Values --filter 'all_records() && sample_selector("value", {"includes": ["ca"]})'
[[0,0.0,0.0],[[[1],[["_id","UInt32"],["value","ShortText"]],[6,"ca"]]]]
select Values --filter 'all_records() && sample_selector("value", {"includes": ["a","c"]})'
[[0,0.0,0.0],[[[2],[["_id","UInt32"],["value","ShortText"]],[1,"a"],[3,"c"]]]]
