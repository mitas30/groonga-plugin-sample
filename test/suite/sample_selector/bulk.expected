register functions/sample
[[0,0.0,0.0],true]
table_create Values TABLE_NO_KEY
[[0,0.0,0.0],true]
column_create Values value COLUMN_SCALAR ShortText
[[0,0.0,0.0],true]
load --table Values
[
{"value": "a"},
{"value": "b"},
{"value": "c"},
{"value": "ab"},
{"value": "ac"}
]
[[0,0.0,0.0],5]
select Values --filter 'all_records() && sample_selector("value", {"includes": "a,b"})'
[[0,0.0,0.0],[[[2],[["_id","UInt32"],["value","ShortText"]],[1,"a"],[2,"b"]]]]
select Values --filter 'all_records() && sample_selector("value", {"includes": "a,ac"})'
[[0,0.0,0.0],[[[2],[["_id","UInt32"],["value","ShortText"]],[1,"a"],[5,"ac"]]]]
select Values --filter 'all_records() && sample_selector("value", {"includes": "a,b,c"})'
